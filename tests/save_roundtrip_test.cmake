cmake_minimum_required(VERSION 3.20)

function(run_save expected)
    execute_process(COMMAND "${CLI}" save ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE text ERROR_VARIABLE err ENCODING UTF-8 TIMEOUT 30)
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR "save ${ARGN}: expected ${expected}, got ${result}; ${text}; ${err}")
    endif()
    if(expected EQUAL 0)
        if(NOT err STREQUAL "")
            message(FATAL_ERROR "successful command wrote stderr: ${err}")
        endif()
    elseif(NOT text STREQUAL "" OR err STREQUAL "")
        message(FATAL_ERROR "failed command must write only stderr: ${text}; ${err}")
    endif()
endfunction()

foreach(kind IN ITEMS global numbered)
    set(sample "${FIXTURES}/${kind}/example.sav")
    set(archive "${OUTPUT}/中文归档/${kind}")
    run_save(0 info "${sample}" --kind "${kind}")
    run_save(0 decrypt "${sample}" --out "${archive}" --overwrite)
    foreach(name IN ITEMS header.bin seed.bin trailer.bin block0.bin block0.lzss manifest.json)
        if(NOT EXISTS "${archive}/${name}")
            message(FATAL_ERROR "missing archive member ${name}")
        endif()
    endforeach()
    foreach(name IN ITEMS header.bin seed.bin trailer.bin block0.bin block0.lzss)
        file(SHA256 "${archive}/${name}" actual)
        file(SHA256 "${FIXTURES}/${kind}/decrypted/${name}" expected)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "independent ${kind} fixture mismatch: ${name}")
        endif()
    endforeach()
    if(kind STREQUAL "numbered")
        file(SHA256 "${archive}/block1.bin" actual)
        file(SHA256 "${FIXTURES}/${kind}/decrypted/block1.bin" expected)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "second stream continuous RNG mismatch")
        endif()
    endif()
    run_save(0 encrypt "${archive}" --out "${OUTPUT}/${kind}.sav" --overwrite)
    file(SHA256 "${sample}" expected)
    file(SHA256 "${OUTPUT}/${kind}.sav" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "byte-exact ${kind} archival roundtrip failed")
    endif()
    run_save(1 encrypt "${archive}" --out "${OUTPUT}/${kind}.sav")
    run_save(1 decrypt "${sample}" --out "${archive}")
    set(report "${OUTPUT}/${kind}.state.json")
    run_save(0 state "${sample}" --out "${report}" --overwrite)
    file(SHA256 "${report}" report_before)
    run_save(1 state "${sample}" --out "${report}")
    file(SHA256 "${report}" report_after)
    if(NOT report_before STREQUAL report_after)
        message(FATAL_ERROR "state report changed despite overwrite refusal")
    endif()
    file(SHA256 "${sample}" source_before)
    run_save(1 state "${sample}" --out "${sample}" --overwrite)
    file(SHA256 "${sample}" source_after)
    if(NOT source_before STREQUAL source_after)
        message(FATAL_ERROR "state export modified its input")
    endif()
    # Same-input protection must hold even when overwriting is requested.
    file(SHA256 "${archive}/block0.bin" before)
    run_save(1 encrypt "${archive}" --out "${archive}/block0.bin" --overwrite)
    file(SHA256 "${archive}/block0.bin" after)
    if(NOT before STREQUAL after)
        message(FATAL_ERROR "source block overwritten")
    endif()
endforeach()

set(alias "${OUTPUT}/same_input")
file(MAKE_DIRECTORY "${alias}")
configure_file("${FIXTURES}/global/example.sav" "${alias}/header.bin" COPYONLY)
file(SHA256 "${alias}/header.bin" before)
run_save(1 decrypt "${alias}/header.bin" --out "${alias}" --overwrite)
file(SHA256 "${alias}/header.bin" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "decrypt modified its input")
endif()
